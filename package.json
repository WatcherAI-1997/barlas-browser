{
  "name": "barlas-browser",
  "version": "0.2.1",
  "description": "Fast, focused Chromium desktop browser by Barlas Bit",
  "homepage": "https://github.com/WatcherAI-1997/barlas-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatcherAI-1997/barlas-browser.git"
  },
  "bugs": {
    "url": "https://github.com/WatcherAI-1997/barlas-browser/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "author": "Barlas Bit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "bit.barlas.browser",
    "productName": "BARLAS Browser",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network;WebBrowser"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BARLAS Browser"
    }
  },
  "dependencies": {
    "country-locale-map": "^1.9.14"
  }
}
