{
  "name": "barlas-browser",
  "version": "0.3.2",
  "description": "Fast, focused Chromium desktop browser by Barlas Bit Technology",
  "homepage": "https://github.com/WatcherAI-1997/barlas-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatcherAI-1997/barlas-browser.git"
  },
  "bugs": {
    "url": "https://github.com/WatcherAI-1997/barlas-browser/issues"
  },
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "author": "Barlas Bit",
  "license": "MIT",
  "scripts": {
    "assets:win": "node scripts/generate-windows-assets.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "bmp-js": "^0.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "bit.barlas.browser",
    "productName": "BARLAS Browser",
    "publish": {
      "provider": "github",
      "owner": "WatcherAI-1997",
      "repo": "barlas-browser",
      "releaseType": "release"
    },
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network;WebBrowser"
    },
    "nsis": {
      "artifactName": "BARLAS-Browser-Setup-${version}-Windows-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "shortcutName": "BARLAS Browser",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "country-locale-map": "^1.9.14",
    "electron-updater": "^6.8.9"
  }
}
